# ==========================================
# AuraTrade Server — Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it is in .gitignore).

# Server
PORT=5000
NODE_ENV=production

# Frontend URL — REQUIRED for CORS. Change to your actual deployed domain in production.
# CLIENT_URL=https://yourdomain.com
CLIENT_URL=http://localhost:5173

# JWT Secret — REQUIRED. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# Poller & Cache Configuration
POLL_INTERVAL_MS=3000
CACHE_TTL_SEC=4

# Optional: Redis (if not set, in-memory cache is used automatically)
# REDIS_URL=redis://default:password@your-redis-cloud:6379

# Optional: MongoDB (if not set, file-based JSON store is used)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/stock_tracker

# ==========================================
# Real Email Delivery (Gmail / SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="AuraTrade Security" <your_gmail@gmail.com>

# ==========================================
# Real SMS Delivery (Twilio - Worldwide)
# ==========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ==========================================
# Real SMS Delivery (Fast2SMS - India)
# ==========================================
FAST2SMS_API_KEY=your_fast2sms_api_key

# ==========================================
# Optional: External Stock Price APIs
# If empty, Yahoo Finance + synthetic generator is used automatically
# ==========================================
FINNHUB_API_KEY=
ALPHA_VANTAGE_KEY=

# ==========================================
# Optional: AI Advisor API Key
# ==========================================
GEMINI_API_KEY=
